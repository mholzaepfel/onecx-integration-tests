{
  "name": "@onecx/integration-tests",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "contributors": [
    "OneCX Development Team <onecx_dev@1000kit.org>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/onecx/onecx-integration-tests"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./it-runner": "./it-runner/index.js"
  },
  "bin": {
    "onecx-it-runner": "dist/it-runner/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:package",
    "build:package": "tsc -p tsconfig.build.json && node ./scripts/copy-dist-assets.js",
    "release": "node ./scripts/release.js",
    "release:minor": "node ./scripts/release.js minor",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "integration-tests": "npm run it:run",
    "it:run": "tsx src/it-runner/index.ts",
    "sonar": "npx sonarqube-scanner"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^13.1.0"
  },
  "peerDependencies": {
    "axios": "^1.18.0",
    "dockerode": "^5.0.0",
    "testcontainers": "^10.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-sonar": "^0.2.16",
    "prettier": "^2.6.2",
    "sonarqube-scanner": "^4.3.2",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minimatch@^9.0.0": "^9.0.7"
  }
}
